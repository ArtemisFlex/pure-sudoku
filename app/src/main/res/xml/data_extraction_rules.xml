<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer keep game data, not the backup-folder link. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="pure_sudoku.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="pure_sudoku.xml" />
    </device-transfer>
</data-extraction-rules>
